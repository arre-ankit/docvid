# Better Auth — required for session signing (32+ chars). Copy to .env.local for `next dev`.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# AI backend when not using the Cloudflare service binding
AI_BACKEND_URL=http://localhost:8787

# OAuth (optional) — buttons appear on /login once both id + secret are set.
# Google Cloud Console → OAuth client → Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub → Settings → Developer settings → OAuth Apps → Authorization callback URL:
#   http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
