{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docvid-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "services": [{ "binding": "AI_BACKEND", "service": "docvid-ai" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "docvid-db",
      "database_id": "9b65ccb9-d3bc-4f8b-b033-8fe36977126b",
      "migrations_dir": "db/migrations"
    }
  ],

  "kv_namespaces": [{ "binding": "KV", "id": "e6d8c7b2695b4621b14fffbc715897fc" }],

  "vars": {
    "AI_BACKEND_URL": "http://localhost:8787",
    "BETTER_AUTH_URL": "https://docvid-web.ankit992827.workers.dev",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://docvid-web.ankit992827.workers.dev"
  }
}
