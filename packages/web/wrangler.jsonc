{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docvid-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Custom domains + subdomain wildcard. Declared here so `deploy` keeps them
  // instead of stripping the routes that were originally set in the dashboard.
  "routes": [
    { "pattern": "docvid.in", "custom_domain": true },
    { "pattern": "www.docvid.in", "custom_domain": true },
    { "pattern": "*.docvid.in/*", "zone_name": "docvid.in" }
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "services": [{ "binding": "AI_BACKEND", "service": "docvid-ai" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "docvid-db",
      "database_id": "9b65ccb9-d3bc-4f8b-b033-8fe36977126b",
      "migrations_dir": "db/migrations"
    }
  ],

  "kv_namespaces": [{ "binding": "KV", "id": "e6d8c7b2695b4621b14fffbc715897fc" }],

  "vars": {
    "AI_BACKEND_URL": "http://localhost:8787",
    "BETTER_AUTH_URL": "https://docvid.in",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://docvid.in,https://www.docvid.in",
    "DODO_PAYMENTS_ENVIRONMENT": "live_mode",
    "DODO_PAYMENTS_SUCCESS_URL": "/library?upgraded=1",
    "DODO_PRO_MONTHLY_PRODUCT_ID": "pdt_0Ni2WG1Wdf06m48SrKMjF"
  }
}
