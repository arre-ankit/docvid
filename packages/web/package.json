{
  "name": "@docvid/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "auth:generate": "npx @better-auth/cli generate --config src/auth/index.ts --output src/db/auth.schema.ts -y",
    "db:migrate:local": "wrangler d1 migrations apply docvid-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply docvid-db --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@better-auth/drizzle-adapter": "^1.6.22",
    "@docvid/shared": "workspace:*",
    "@ffmpeg/ffmpeg": "0.12.10",
    "@ffmpeg/util": "0.12.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-three/fiber": "^9.6.1",
    "@shadergradient/react": "^2.4.20",
    "@tanstack/react-pacer": "^0.19.3",
    "@vercel/analytics": "^1.6.1",
    "better-auth": "^1.6.22",
    "better-auth-cloudflare": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.0",
    "lucide-react": "^0.562.0",
    "matter-js": "^0.20.0",
    "motion": "^12.41.0",
    "nanoid": "^5.1.6",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-resizable-panels": "^2.1.7",
    "server-only": "^0.0.1",
    "shadcn": "^3.6.2",
    "shiki": "^3.2.0",
    "simple-icons": "^16.24.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.185.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250601.0",
    "@opennextjs/cloudflare": "^1.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.36.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.20.0"
  }
}
